# --- Base PostgreSQL ---
# postgres://UTILISATEUR:MOT_DE_PASSE@localhost:5432/genesis
DATABASE_URL=postgres://genesis:changez-moi@localhost:5432/genesis

# --- Sécurité ---
# Chaîne aléatoire d'au moins 32 caractères (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
JWT_EXPIRES=8h
# Clé partagée avec le moteur d'analyse Python (même valeur dans Analyse/.env)
ANALYZER_KEY=

# --- Application ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
ANALYZER_URL=http://127.0.0.1:5001
MAX_FILE_MB=15
MAX_FILES_PER_RUN=25

# --- Compte créé au premier démarrage (si absent) ---
DEFAULT_ACCOUNT_EMAIL=
DEFAULT_ACCOUNT_PASSWORD=
DEFAULT_ACCOUNT_NAME=Administrateur Genesis
