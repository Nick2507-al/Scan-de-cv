# Clé partagée avec le backend (même valeur que ANALYZER_KEY dans Backend/.env)
ANALYZER_KEY=
# Service ML distant (Space Hugging Face privé) — laissé vide = mode règles uniquement
ML_SERVICE_URL=https://VOTRE-PSEUDO-genesis-ml.hf.space
# Jeton Hugging Face (lecture suffit pour interroger le Space ; « write » pour le déployer)
HF_TOKEN=
# Région téléphonique par défaut pour les numéros sans indicatif (FR, CG, CD, CM, CI, SN…)
DEFAULT_PHONE_REGION=FR
MAX_FILE_MB=15

# Modèle GLiNER local (dossier/fichier sous %LOCALAPPDATA%\Genesis\models). Défaut : gliner/model_fp16.onnx
# GENESIS_GLINER=gliner-ft/model.onnx
