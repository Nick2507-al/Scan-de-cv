# Exemple de configuration pour cvmatch-backend (.env)
# Dupliquez ce fichier en ".env" et remplissez selon votre environnement local.

# ==========================
# IA locale (Ollama)
# ==========================
# Host/port du service Ollama local
OLLAMA_HOST=http://127.0.0.1:11434
# Modèle par défaut (assurez-vous de l'avoir téléchargé avec `ollama pull`)
OLLAMA_MODEL=mistral:latest

# ==========================
# Base de données MySQL
# ==========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cvmatch_db

# ==========================
# Authentification (JWT)
# ==========================
# Clé secrète utilisée pour signer les tokens JWT (générez une valeur longue et aléatoire)
SECRET_KEY=change_me_to_a_long_random_string
# Durée d'expiration du token en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================
# SMTP (optionnel, pour envoi d'emails)
# ==========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false